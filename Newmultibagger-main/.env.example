# Copy this file to .env — never commit .env itself

# ── Data sources ──────────────────────────────────────────────────────────────
#
# yfinance (default, no key needed)
#
# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (default, no setup needed):
# DATABASE_URL=sqlite:///stocks.db
#
# PostgreSQL / TimescaleDB (production):
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/multibagger_db

# ── Task queue ────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# Upstash Redis (ConnectionManager prefers UPSTASH_REDIS_TCP_URL if set)
# IMPORTANT: Use the rediss:// TCP URL for Celery/PubSub, NOT the REST URL.
# UPSTASH_REDIS_TCP_URL=rediss://default:PASSWORD@endpoint:port

# ── Risk governor ─────────────────────────────────────────────────────────────
VIX_KILL_SWITCH=25
MAX_SECTOR_EXPOSURE=0.30
MAX_DRAWDOWN_RATE=0.15
MAX_CORRELATION_THRESHOLD=0.80

# ── App ───────────────────────────────────────────────────────────────────────
DEBUG=false
LOG_LEVEL=INFO

# Sovereign API Security
SOVEREIGN_API_KEY=your_secure_key_here

# WebSocket Auth Token Secret
# Must be a 256-bit (64-char hex) random value.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
WS_TOKEN_SECRET=your_ws_token_secret_here

# Allowed IPs for Prometheus /metrics scraping (comma-separated).
# If deploying behind a reverse proxy (e.g. Nginx, Traefik), include the proxy container's IP (e.g. 172.17.0.1) or the Prometheus container's IP.
ALLOWED_METRICS_IPS=127.0.0.1,::1
